{
  "name": "dirhamku-firebase",
  "version": "5.0.1",
  "description": "Dirhamku - Money Keeper | Firebase Edition",
  "private": true,
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "watch:css": "npx tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "deploy": "npm run build:css && firebase deploy",
    "deploy:hosting": "npm run build:css && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "serve": "npm run build:css && firebase emulators:start",
    "migrate": "node scripts/migrate-from-sheets.js",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "firebase-tools": "^13.0.0",
    "tailwindcss": "^3.4.19"
  }
}